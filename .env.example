# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey) — used by claim
# extraction (Phase 2, gemini-2.5-flash).
GEMINI_API_KEY=your-gemini-key-here

# NOT currently required: ingestion uses Reddit's public JSON endpoints.
# Only needed if we later swap in a PRAW-based fetcher after Reddit API
# approval (https://www.reddit.com/prefs/apps).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
